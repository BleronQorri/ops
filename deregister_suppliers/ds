#!/usr/bin/env bash
# ds — deregister_suppliers wrapper (trigger Invopop supplier deregistration workflow)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
exec elixir "$DIR/deregister_suppliers.exs" "$@"
