#!/usr/bin/env node
"use strict";

const { CommanderError } = require("commander");
const { buildProgram, shortHelp } = require("../lib/program");
const config = require("../lib/config");
const ui = require("../lib/ui");

async function main() {
  const program = buildProgram();
  require("../lib/orion").register(program);

  const argv = process.argv.slice(2);
  if (argv.length === 0) {
    // Bare `ops` on a terminal opens the interactive screen; in a pipe or a
    // script it prints the short help and exits 0 (like `gh`), as it always has.
    // `interactive.bare false` keeps the short help on a terminal too.
    if (opensOnBare() && process.stdin.isTTY && process.stdout.isTTY) {
      return await require("../lib/orion/interactive").open();
    }
    process.stdout.write(shortHelp(program));
    return 0;
  }
  try {
    await program.parseAsync(argv, { from: "user" });
    return typeof process.exitCode === "number" ? process.exitCode : 0;
  } catch (err) {
    if (err instanceof CommanderError) {
      // --help / --version already printed by commander
      if (err.code === "commander.helpDisplayed" || err.code === "commander.version" || err.code === "commander.help") return 0;
      // commander already wrote the error line (and a suggestion) to stderr
      return 2;
    }
    if (err instanceof ui.UsageError) {
      ui.eprint(`${ui.cerr.bad("error:")} ${err.message}`);
      if (err.hint) ui.eprint(err.hint);
      return 2;
    }
    if (err instanceof ui.ProblemsError) {
      if (err.message) ui.eprint(`${ui.cerr.bad("error:")} ${err.message}`);
      return 1;
    }
    ui.eprint(`${ui.cerr.bad("error:")} ${err.stack || err.message}`);
    return 1;
  }
}

// On unless turned off. `ops config set interactive.bare false` writes the string,
// the JSON file may hold the boolean; both mean the same thing here.
function opensOnBare() {
  const v = config.get("interactive.bare");
  return !(v === false || v === "false");
}

main().then((code) => process.exit(code));
