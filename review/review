#!/usr/bin/env bash
#
# review — caveman-style PR review from anywhere in the terminal.
#
# Prompts for an Orion app, cd's into ~/desktop/repos/orion/<app>, resolves a PR
# (by number/URL, or by browsing authors who have open PRs — optionally filtered
# to a Houston team), then runs Claude Code headlessly with the caveman-review
# skill and prints the terse findings.
#
# Every interactive menu has a "← Back" entry; the top app menu has "✕ Quit".
#
# Before launching it asks whether to run an interactive session (so you can ask
# follow-up questions about the review — explain a finding, show the code, etc.)
# or just print the review and exit. Pass -p/--print to skip the prompt and print.
#
# Usage:
#   review                          # pick app, then resolve a PR interactively
#   review <app>                    # pick app, then resolve a PR interactively
#   review <app> <pr>               # <pr> = number | #n | full PR URL
#   review <app> <author>           # browse that author's open PRs and pick one
#   review [<app>] --team <team>    # browse open PRs of that Houston team's members
#   review ... -p|--print           # print the review and exit (no follow-up)
#
set -euo pipefail

ORION_DIR="$HOME/desktop/repos/orion"
BACK="← Back"
QUIT="✕ Quit"

err() { printf '%s\n' "$*" >&2; }

# --- arg parsing: pull out --team/-t and -p/--print, keep the rest positional
team=""
print_mode=0
positional=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t | --team) team="${2:-}"; shift 2 ;;
    --team=*)    team="${1#*=}"; shift ;;
    -p | --print) print_mode=1; shift ;;
    *)           positional+=("$1"); shift ;;
  esac
done
set -- ${positional[@]+"${positional[@]}"}
arg_app="${1:-}"
arg_pr="${2:-}"

# Is the argument a PR reference (bare number, #number, or a .../pull/<n> URL)?
is_pr_ref() {
  case "$1" in
    *github.com*/pull/[0-9]*) return 0 ;;
  esac
  local n="${1#\#}"
  case "$n" in
    '' | *[!0-9]*) return 1 ;;   # empty or contains a non-digit -> not a PR number
    *) return 0 ;;
  esac
}

# Print "<count> <login>" per author with open PRs in the current repo (bots out).
open_pr_authors() {
  gh pr list --state open --limit 300 --json author --jq '.[].author.login' \
    | grep -vE '^app/|\[bot\]' \
    | sort | uniq -c | sort -rn | sed 's/^ *//'
}

# Pick an Orion app. Sets global `app`. Returns 1 if the user chose Quit.
choose_app() {
  local apps=() d choice
  while IFS= read -r d; do
    apps+=("$(basename "$d")")
  done < <(find "$ORION_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort)
  [ "${#apps[@]}" -gt 0 ] || { err "No app directories under $ORION_DIR"; exit 1; }

  echo "Select an app:"
  PS3="app> "
  select choice in "${apps[@]}" "$QUIT"; do
    [ "${choice:-}" = "$QUIT" ] && return 1
    if [ -n "${choice:-}" ]; then app="$choice"; return 0; fi
    err "Pick a number from the list."
  done
}

# Pick any author who has open PRs. Sets global `author`. Returns 1 on Back.
choose_author() {
  author=""
  local authors=() logins=() line cnt login pick
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    cnt="${line%% *}"; login="${line#* }"
    logins+=("$login")
    authors+=("$login ($cnt open)")
  done < <(open_pr_authors)

  if [ "${#logins[@]}" -eq 0 ]; then
    err "No authors with open PRs in this repo."
    return 1
  fi

  echo "Authors with open PRs:" >&2
  PS3="author> "
  select pick in "${authors[@]}" "$BACK"; do
    [ "${pick:-}" = "$BACK" ] && return 1
    if [ -n "${pick:-}" ]; then author="${logins[$((REPLY - 1))]}"; return 0; fi
    err "Pick a number from the list."
  done
}

# Pick an author who has open PRs AND belongs to a Houston team. $1 = team query.
# Sets global `author`. Returns 1 on Back / unknown team / no matching members.
choose_team_member() {
  author=""
  local query="$1"
  command -v houston >/dev/null || { err "houston CLI not found — cannot filter by team."; return 1; }
  command -v jq >/dev/null      || { err "jq not found — cannot filter by team."; return 1; }

  # Validate the team and get its canonical name via Houston.
  local tjson canonical
  tjson="$(houston who "$query" --json 2>/dev/null || true)"
  canonical="$(printf '%s' "$tjson" | jq -r '.name // empty' 2>/dev/null || true)"
  if [ -z "$canonical" ] || ! printf '%s' "$tjson" | jq -e '.members' >/dev/null 2>&1; then
    err "'$query' is not a team known to Houston."
    return 1
  fi

  local want
  want="$(printf '%s' "$canonical" | tr '[:upper:]' '[:lower:]')"

  echo "Resolving ${canonical} members among open-PR authors…" >&2
  local mlogins=() mlabels=() line cnt login pjson pteam pname
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    cnt="${line%% *}"; login="${line#* }"
    pjson="$(houston who is "$login" --json 2>/dev/null || true)"
    pteam="$(printf '%s' "$pjson" | jq -r '.team // empty' 2>/dev/null || true)"
    [ "$(printf '%s' "$pteam" | tr '[:upper:]' '[:lower:]')" = "$want" ] || continue
    pname="$(printf '%s' "$pjson" | jq -r '.name // empty' 2>/dev/null || true)"
    mlogins+=("$login")
    mlabels+=("${pname:-$login} ($login · $cnt open)")
  done < <(open_pr_authors)

  if [ "${#mlogins[@]}" -eq 0 ]; then
    err "No ${canonical} members have open PRs in this repo."
    return 1
  fi

  echo "${canonical} members with open PRs:" >&2
  PS3="member> "
  local pick
  select pick in "${mlabels[@]}" "$BACK"; do
    [ "${pick:-}" = "$BACK" ] && return 1
    if [ -n "${pick:-}" ]; then author="${mlogins[$((REPLY - 1))]}"; return 0; fi
    err "Pick a number from the list."
  done
}

# List an author's open PRs in the current repo. Sets global `pr`.
# Returns 1 on Back (or when the author has no open PRs).
pick_pr_by_author() {
  local who="$1"
  local nums=() labels=() num label
  while IFS=$'\t' read -r num label; do
    [ -n "$num" ] || continue
    nums+=("$num")
    labels+=("$label")
  done < <(
    gh pr list --author "$who" --state open --limit 100 \
      --json number,title,createdAt \
      --template '{{range .}}{{printf "%v\t#%v · %s · %s\n" .number .number (timefmt "2006-01-02" .createdAt) (truncate 90 .title)}}{{end}}'
  )

  if [ "${#nums[@]}" -eq 0 ]; then
    err "No open PRs found for '${who}' in this repo."
    return 1
  fi

  echo "Open PRs by ${who}:" >&2
  PS3="pr> "
  select label in "${labels[@]}" "$BACK"; do
    [ "${label:-}" = "$BACK" ] && return 1
    if [ -n "${label:-}" ]; then pr="${nums[$((REPLY - 1))]}"; return 0; fi
    err "Pick a number from the list."
  done
}

# Browse loop: <chooser> picks an author (back-aware), then pick one of their PRs.
# Back from the PR list returns to the chooser; back from the chooser returns 1.
browse_with() {
  local chooser="$1"; shift
  while true; do
    "$chooser" "$@" || return 1
    pick_pr_by_author "$author" && return 0
  done
}

# Resolve a raw token (non-interactive): PR ref -> use directly; else treat as an
# author handle and browse their open PRs.
resolve_pr() {
  local input="$1"
  if is_pr_ref "$input"; then
    pr="$input"
  else
    pick_pr_by_author "$input" || true
  fi
}

# Interactive PR finder. Sets global `pr`. Returns 1 to go back to app selection.
find_pr() {
  pr=""
  local how ans t
  while true; do
    echo "Find a PR by:"
    PS3="find> "
    select how in "PR number / URL" "Author (open PRs)" "My open PRs" "Team members (open PRs)" "$BACK"; do
      case "${REPLY:-}" in
        1)
          printf 'PR number / URL (blank to go back): '
          read -r ans
          [ -z "$ans" ] && break
          resolve_pr "$ans"
          [ -n "$pr" ] && return 0
          break
          ;;
        2) browse_with choose_author && return 0; break ;;
        3) pick_pr_by_author "@me" && return 0; break ;;
        4)
          t="$team"
          if [ -z "$t" ]; then
            printf 'Team (blank = orion): '
            read -r t
            [ -z "$t" ] && t="orion"
          fi
          browse_with choose_team_member "$t" && return 0
          break
          ;;
        5) return 1 ;;
        *) err "Pick 1-5." ;;
      esac
    done
  done
}

[ -d "$ORION_DIR" ] || { err "Orion dir not found: $ORION_DIR"; exit 1; }
command -v claude >/dev/null || { err "claude CLI not found on PATH"; exit 1; }
command -v gh     >/dev/null || { err "gh CLI not found on PATH"; exit 1; }

enter_app() {
  app_dir="$ORION_DIR/$1"
  [ -d "$app_dir" ] || { err "No such app: $app_dir"; exit 1; }
  cd "$app_dir"
  echo "→ $app_dir"
}

pr=""

if [ -n "$arg_pr" ]; then
  # Non-interactive: review <app> <pr-or-author>
  enter_app "$arg_app"
  resolve_pr "$arg_pr"
  [ -n "$pr" ] || { err "No PR selected."; exit 1; }
else
  # Interactive, with back-navigation between app -> find -> author/team -> PR.
  while true; do
    if [ -n "$arg_app" ]; then
      app="$arg_app"
    else
      choose_app || exit 0
    fi
    enter_app "$app"

    if [ -n "$team" ]; then
      # --team given: go straight to that team's members with open PRs.
      browse_with choose_team_member "$team" && break
    else
      find_pr && break
    fi
    # Asked to go back: if the app was fixed by arg there's nothing above.
    [ -n "$arg_app" ] && exit 0
  done
fi

echo "→ reviewing PR ${pr}"

# Choose run mode unless -p/--print already forced it. No TTY -> just print.
if [ "$print_mode" -eq 0 ]; then
  if [ -t 0 ]; then
    echo "Run mode:"
    PS3="mode> "
    select _m in "Interactive (ask follow-ups after the review)" "Print and exit"; do
      case "${REPLY:-}" in
        1) print_mode=0; break ;;
        2) print_mode=1; break ;;
        *) err "Pick 1 or 2." ;;
      esac
    done
  else
    print_mode=1
  fi
fi

# Run the caveman review (read-only: gh + file reads).
prompt="Use the caveman-review skill to review pull request: ${pr}
Fetch it with gh, map line numbers from the diff hunks, and output the terse
caveman-style findings ready to paste into the PR. Do not post anything to GitHub.
After the review, stay available for follow-up questions about it."

allowed="Bash(gh:*) Bash(find:*) Read Grep Glob"

if [ "$print_mode" -eq 1 ]; then
  # One-shot: print the review and exit.
  exec claude -p "$prompt" --allowedTools "$allowed"
else
  # Interactive: review prints first, then you can ask follow-up questions.
  echo "(interactive — ask follow-ups after the review; /exit or Ctrl-D to quit)"
  exec claude "$prompt" --allowedTools "$allowed"
fi
