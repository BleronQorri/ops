# einvoicing-scripts — environment template.
#
# Copy this file to `.env` (same directory, the repo root) and fill in real
# values. `.env` is gitignored and never committed — keep secrets there only.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Scripts auto-load the repo-root `.env` at startup. Anything already set in your
# shell environment takes precedence over `.env` (so you can override per-run
# with `VAR=… ./script.exs`).
#
# Variables are grouped by the environment the consuming scripts act on, matching
# the production/ and staging/ folders.

# ============================================================================
# PRODUCTION  (production/ scripts — touch real production data)
# ============================================================================

# invopop_supplier_check — Bearer token for the Invopop REST API against a
# PRODUCTION workspace. The token itself selects the workspace/integration.
# SECRET — do not commit.
INVOPOP_API_TOKEN=

# Optional. Defaults to https://api.invopop.com when unset.
INVOPOP_API_BASE_URL=https://api.invopop.com

# ============================================================================
# STAGING  (staging/ scripts — Invopop sandbox + Comarch UAT)
# ============================================================================

# deregister_suppliers — Bearer token for a SANDBOX Invopop workspace. Kept
# separate from the production token above; the script REFUSES to run unless the
# token's workspace is a sandbox. SECRET — do not commit.
INVOPOP_SANDBOX_API_TOKEN=

# Optional. Defaults to https://api.invopop.com when unset.
INVOPOP_SANDBOX_API_BASE_URL=https://api.invopop.com

# deregister_suppliers workflow IDs (staging sandbox), one per integration.
# NOT secret — the known Fresha staging values from
# app-accounting-documents/deploy/apps/staging/values.yaml. Refresh here if a
# workflow is re-created/renamed in Invopop. Unset ones just drop out of the
# picker (you can always pass --workflow-id).
INVOPOP_DEREGISTER_WORKFLOW_ES_VERIFACTU=9a5ecade-0e0a-49b0-a847-dfcef78d9d62
INVOPOP_DEREGISTER_WORKFLOW_ES_TICKETBAI=7c72c919-052c-4964-9ffe-e33caa0c56be
INVOPOP_DEREGISTER_WORKFLOW_IT_SMARTRECEIPTS=a97ef713-764d-4e4e-9b3f-2e1139cde719

# confirm_sent_uat — JWT for the edoc-online UAT REST API. If unset, the script
# prompts for it. SECRET — do not commit.
COMARCH_UAT_JWT=
